# Copy to .env for the local Compose stack; never commit real credentials.
DB_USER=wishlist
DB_PASSWORD=
DB_NAME=wishlist
SECRET_KEY=
ALGORITHM=HS256
ENVIRONMENT=development
DB_SSLMODE=disable
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
PORT=8000
API_PORT=8000
UI_PORT=8080
VITE_API_BASE=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8080

# For PaaS, set DATABASE_URL (pooled PostgreSQL URL) and REDIS_URL (rediss:// URL)
# as platform environment variables. Set MIGRATION_DATABASE_URL only in GitHub
# environment secrets; it must be the direct Neon connection URL.
